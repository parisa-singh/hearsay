# Copy this file to .env.local and fill in values
# .env.local is gitignored — never commit actual keys

# Cloudflare Workers base URL (get this after running: cd workers && npx wrangler deploy)
VITE_API_BASE_URL=https://hearsay-api.YOUR_SUBDOMAIN.workers.dev

# Google Analytics 4 measurement ID (GA4 → Admin → Data Streams → your web stream).
# Optional — leave unset and analytics stays fully disabled (no gtag script loads).
# Also add as a GitHub Actions repo secret so production builds pick it up.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
